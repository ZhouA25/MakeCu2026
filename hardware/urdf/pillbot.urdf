<?xml version="1.0"?>
<!-- Generated by `python -m pillbot.sim.urdf` from configs/sim.yaml — edit that, not this file. -->
<robot name="pillbot">
  <mujoco><compiler strippath="false" balanceinertia="true" discardvisual="false" fusestatic="false"/></mujoco>
  <link name="base_link"><inertial><origin xyz="0 0 0"/><mass value="0.5"/><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/></inertial>
    <visual><origin xyz="0.0008 -0.005900000000000001 0.1184" rpy="0 0 0"/><geometry><mesh filename="../stl/arm/base.stl" scale="0.001 0.001 0.001"/></geometry><material name="m_base"><color rgba="0.6 0.6 0.65 1"/></material></visual>
    <visual><origin xyz="0.0008 -0.005900000000000001 0.1184" rpy="0 0 0"/><geometry><mesh filename="../stl/arm/base_plate.stl" scale="0.001 0.001 0.001"/></geometry><material name="m_base_plate"><color rgba="0.4 0.4 0.45 1"/></material></visual>
  </link>
  <joint name="shoulder_pan" type="revolute"><parent link="base_link"/><child link="pan_link"/><origin xyz="0 0 0.08" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-2.6180" upper="2.6180" effort="0.52" velocity="5"/></joint>
  <link name="pan_link"><inertial><origin xyz="0 0 0.085"/><mass value="0.15"/><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/></inertial>
    <visual><origin xyz="0 0 0.085"/><geometry><cylinder radius="0.03" length="0.17"/></geometry>
      <material name="tower"><color rgba="0.6 0.6 0.65 1"/></material></visual>
  </link>
  <joint name="shoulder_lift" type="revolute"><parent link="pan_link"/><child link="upper_arm"/><origin xyz="0 0 0.17" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-1.7453" upper="1.7453" effort="1.6" velocity="5"/></joint>
  <link name="upper_arm"><inertial><origin xyz="0 0 0.075"/><mass value="0.06"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><origin xyz="0.0008 -0.00605 -0.1663" rpy="0 0 0"/><geometry><mesh filename="../stl/arm/link_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="m_link_1"><color rgba="0.95 0.55 0.15 1"/></material></visual>
    <visual><origin xyz="0.0008 -0.00605 -0.1663" rpy="0 0 0"/><geometry><mesh filename="../stl/arm/elbow_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="m_elbow_1"><color rgba="0.7 0.7 0.75 1"/></material></visual>
    <visual><origin xyz="0.0008 -0.00605 -0.1663" rpy="0 0 0"/><geometry><mesh filename="../stl/arm/elbow_2.stl" scale="0.001 0.001 0.001"/></geometry><material name="m_elbow_2"><color rgba="0.7 0.7 0.75 1"/></material></visual>
  </link>
  <joint name="elbow_flex" type="revolute"><parent link="upper_arm"/><child link="forearm"/><origin xyz="0 0 0.15" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-2.6180" upper="2.6180" effort="0.52" velocity="5"/></joint>
  <link name="forearm"><inertial><origin xyz="0 0 0.075"/><mass value="0.06"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><origin xyz="0.00075 0.00199 -0.3456" rpy="0 0 0"/><geometry><mesh filename="../stl/arm/link_2.stl" scale="0.001 0.001 0.001"/></geometry><material name="m_link_2"><color rgba="0.95 0.55 0.15 1"/></material></visual>
    <visual><origin xyz="0.00075 0.00199 -0.3456" rpy="0 0 0"/><geometry><mesh filename="../stl/arm/wrist_gear_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="m_wrist_gear_1"><color rgba="0.7 0.7 0.75 1"/></material></visual>
  </link>
  <joint name="wrist_roll" type="revolute"><parent link="forearm"/><child link="gripper_link"/><origin xyz="0 0 0.15" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-3.1416" upper="3.1416" effort="0.52" velocity="5"/></joint>
  <link name="gripper_link"><inertial><origin xyz="-0.01 0.01 0.05"/><mass value="0.08"/><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/></inertial>
    <visual><origin xyz="0.0 0.0 0.0" rpy="0 0 0"/><geometry><mesh filename="../stl/gripper_so101/wrist_roll_follower_so101.stl" scale="0.001 0.001 0.001"/></geometry><material name="m_wrist_roll_follower_so101"><color rgba="0.9 0.9 0.92 1"/></material></visual>
  </link>
  <joint name="gripper" type="revolute"><parent link="gripper_link"/><child link="moving_jaw"/><origin xyz="0.0202 -0.0188 0.0234" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-0.1745" upper="1.7453" effort="0.52" velocity="5"/></joint>
  <link name="moving_jaw"><inertial><origin xyz="-0.008 0.019 0.04"/><mass value="0.03"/><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/></inertial>
    <visual><origin xyz="0.0 0.0189 0.0" rpy="-1.5707963267948966 0 0"/><geometry><mesh filename="../stl/gripper_so101/moving_jaw_so101.stl" scale="0.001 0.001 0.001"/></geometry><material name="m_moving_jaw_so101"><color rgba="0.9 0.9 0.92 1"/></material></visual>
  </link>
  <!-- where the cap's centre sits when gripped against the fixed jaw (standard_amber_40dr) -->
  <joint name="grasp_joint" type="fixed"><parent link="gripper_link"/><child link="grasp_frame"/>
    <origin xyz="0.0124 0.0 0.08" rpy="0 0 0"/></joint>
  <link name="grasp_frame"/>
  <!-- fixed jaw inner face, for reference: ((-0.0133, 0.05), (-0.0079, 0.1)) (x, z in m, gripper_link frame) -->
</robot>
