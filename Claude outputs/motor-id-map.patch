diff --git a/configs/robot.yaml b/configs/robot.yaml
index 8a62b3b..0a9b1dc 100644
--- a/configs/robot.yaml
+++ b/configs/robot.yaml
@@ -8,10 +8,10 @@ follower:
   id: pillbot_follower
   preset: all_m288              # we have 5-10 XL330-M288 and no XL430s
   # Arm: github.com/danslovich/5DOF_Robot_Arm — 5x XL330-M288, 4:1 printed planetary on the shoulder,
-  # NO wrist pitch. Explicit IDs below were supplied by the user on 2026-11-08.
+  # NO wrist pitch. Explicit IDs below were confirmed by the user on 2026-11-08.
   joints: [shoulder_pan, shoulder_lift, elbow_flex, wrist_roll, gripper]
-  motor_ids: {shoulder_lift: 12, wrist_roll: 15, gripper: 10}
-  # shoulder_pan and elbow_flex retain defaults 1 and 3; physical IDs not yet confirmed.
+  # 11 = shoulder rotation about z, 12 = horizontal shoulder rotation, 13 = elbow, 15 = wrist, 10 = top gripper
+  motor_ids: {shoulder_pan: 11, shoulder_lift: 12, elbow_flex: 13, wrist_roll: 15, gripper: 10}
   gripper_goal_current: 1000    # mA (XL330 max 1750). Higher = stronger grip on the cap, more heat
   use_degrees: true             # arm joints in degrees (scripted code assumes this)
